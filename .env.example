PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrilink_mobile

JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_SECRET=your_refresh_secret_change_in_production
REFRESH_EXPIRES_IN=7d

# Nodemailer — Gmail SMTP (dùng App Password, không phải mật khẩu thường)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_app_password_16_chars
MAIL_FROM="AgriLink <your_gmail@gmail.com>"

NODE_ENV=development
