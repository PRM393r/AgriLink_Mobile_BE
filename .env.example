PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrilink_mobile

JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_SECRET=your_refresh_secret_change_in_production
REFRESH_EXPIRES_IN=7d

# Nodemailer — Gmail SMTP (dùng App Password, không phải mật khẩu thường)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_app_password_16_chars
MAIL_FROM="AgriLink <your_gmail@gmail.com>"

NODE_ENV=development

# PayOS — cổng thanh toán (https://payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL public backend để PayOS gọi webhook, vd: https://api.agrilink.vn/api/v1/payments/payos/webhook
PAYOS_WEBHOOK_URL=
# Deep link đưa buyer quay lại app mobile sau khi thanh toán xong/hủy trên trình duyệt PayOS
# (cần AndroidManifest.xml + Info.plist đăng ký scheme "agrilink", đã cấu hình sẵn)
PAYOS_RETURN_URL=agrilink://payment-result?status=success
PAYOS_CANCEL_URL=agrilink://payment-result?status=cancel

# Cloudinary — lưu trữ ảnh sản phẩm/avatar (https://cloudinary.com, free tier đủ dùng)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
